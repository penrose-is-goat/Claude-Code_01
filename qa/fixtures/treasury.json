        {"auctionDate": "2012-10-11", "cusip": "912828VX4", "securityTerm": "10-Year", "reopening": false, "bidToCoverRatio": 2.81, "directBidderShare": null, "indirectBidderShare": 34.2, "missingFields": ["directBidderShare"], "resultPdfUrl": "https://www.treasurydirect.gov/instit/annceresult/press/preanre/2012/R_20121011_3.pdf"}
