# NOTE: Prisma resolves a RELATIVE sqlite path against prisma/schema.prisma, not the
# project root. "./data/app.db" would silently land in prisma/data/ — where the README
# tells you to back up data/app.db and you would copy nothing. "../data/" puts it where
# docker-compose mounts it and where the backup instructions point.
DATABASE_URL="file:../data/app.db"
POLL_TOKEN="dev-local-token"
TZ="America/Denver"
